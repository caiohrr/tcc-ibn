{
  "ID": "h1_h2_to_s1",
  "VERSION": "1.0",
  "DESCRIPTION": "Connects h1 and h2 to s1, with 100Mbps bandwidth on h1-s1 link.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1"
      },
      {
        "ID": "h2"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100
      }
    },
    {
      "ENDPOINTS": ["h2", "s1"]
    }
  ]
}