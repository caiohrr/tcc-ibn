{
  "ID": "h1_s1_connection",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple topology connecting h1 to s1 with specific link parameters.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch"
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 50,
        "DELAY": "5ms"
      }
    }
  ]
}