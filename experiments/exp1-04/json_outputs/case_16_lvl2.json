{
  "ID": "simple_h1_s1_link",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple topology with one host h1 connected to one switch s1 with a 1000Mbps link.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "192.168.0.5/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 1000
      }
    }
  ]
}