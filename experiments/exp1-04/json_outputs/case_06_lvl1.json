{
  "ID": "two_switches_two_hosts",
  "VERSION": "1.0",
  "DESCRIPTION": "Topology with two switches (s1, s2) and two hosts (h1, h2). h1 connects to s1, h2 connects to s2, and s1 connects to s2.",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      },
      {
        "ID": "s2"
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"]
    },
    {
      "ENDPOINTS": ["h2", "s2"]
    },
    {
      "ENDPOINTS": ["s1", "s2"]
    }
  ]
}