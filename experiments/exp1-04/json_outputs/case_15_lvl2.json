{
  "ID": "lossy_link_topology",
  "VERSION": "1.0",
  "DESCRIPTION": "Topology with a 1% packet loss link between h1 and s1.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "LOSS": 1
      }
    },
    {
      "ENDPOINTS": ["h2", "s1"]
    }
  ]
}