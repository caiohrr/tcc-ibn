{
  "ID": "star_topology_4_hosts",
  "VERSION": "1.0",
  "DESCRIPTION": "A star topology with one central switch (s1) and four connected hosts (h1-h4).",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAX_CPU": 0.6
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24",
        "MAX_RAM": 512
      },
      {
        "ID": "h3",
        "IP": "10.0.0.3/24"
      },
      {
        "ID": "h4",
        "IP": "10.0.0.4/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "2ms"
      }
    },
    {
      "ENDPOINTS": ["h2", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100
      }
    },
    {
      "ENDPOINTS": ["h3", "s1"],
      "PARAMS": {
        "BANDWIDTH": 50,
        "LOSS": 0.5
      }
    },
    {
      "ENDPOINTS": ["h4", "s1"]
    }
  ]
}