{
  "ID": "SimpleHostSwitchNet",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple network with one host (h1) connected to one switch (s1).",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAC": "00:00:00:00:00:01",
        "MAX_CPU": 0.7,
        "MAX_RAM": 512
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "1ms",
        "LOSS": 0.1
      }
    }
  ]
}