      "PARAMS": {
        "LOSS": 1
      }
    },
    {
      "ENDPOINTS": ["h6", "s1"],
      "PARAMS": {
        "LOSS": 1
      }
    },
    {
      "ENDPOINTS": ["h7", "s1"],
      "PARAMS": {
        "LOSS": 1
      }
    },
    {
      "ENDPOINTS": ["h8", "s1"],
      "PARAMS": {
        "LOSS": 1
      }
    }
  ]
