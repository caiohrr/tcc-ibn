{
  "ID": "PointToPoint",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple point-to-point topology connecting h1 directly to h2.",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAX_CPU": 0.7,
        "MAX_RAM": 512
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24"
      }
    ],
    "SWITCHES": [],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "h2"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "1ms"
      }
    }
  ]
}