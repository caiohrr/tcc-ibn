{
  "ID": "HighAvailabilityNet",
  "VERSION": "1.0",
  "DESCRIPTION": "Ambiente de alta disponibilidade com monitoramento agressivo (intervalo 2s, com recuperação).",
  "MONITORING": {
    "enabled": true,
    "interval": 2,
    "recovery_enabled": true
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAC": "00:00:00:00:00:01",
        "MAX_CPU": 0.7,
        "MAX_RAM": 512
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24",
        "MAC": "00:00:00:00:00:02",
        "MAX_CPU": 0.6,
        "MAX_RAM": 256
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "2ms",
        "LOSS": 0.5
      }
    },
    {
      "ENDPOINTS": ["h2", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "2ms"
      }
    },
    {
      "ENDPOINTS": ["s1", "c0"]
    }
  ]
}