    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24"
      },
      {
        "ID": "h3",
        "IP": "10.0.0.3/24"
      },
      {
        "ID": "h4",
        "IP": "10.0.0.4/24"
      },
      {
        "ID": "h5",
        "IP": "10.0.0.5/24"
      },
      {
        "ID": "h6",
        "IP": "10.0.0.6/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch"
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"]
    },
    {
      "ENDPOINTS": ["h2", "s1"]
    },
    {
      "ENDPOINTS": ["h3", "s1"]
    },
    {
      "ENDPOINTS": ["h4", "s1"]
    },
    {
      "ENDPOINTS": ["h5", "s1"]
    },
    {
      "ENDPOINTS": ["h6", "s1"]
    }
  ]
