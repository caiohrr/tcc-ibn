{
  "ID": "four_hosts_remote_controller",
  "VERSION": "1.0",
  "DESCRIPTION": "Topology with 4 hosts connected to a single switch, managed by a remote controller. All hosts have 512MB RAM.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAX_RAM": 512
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24",
        "MAX_RAM": 512
      },
      {
        "ID": "h3",
        "IP": "10.0.0.3/24",
        "MAX_RAM": 512
      },
      {
        "ID": "h4",
        "IP": "10.0.0.4/24",
        "MAX_RAM": 512
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "192.168.56.1",
          "PORT": 6633
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"]
    },
    {
      "ENDPOINTS": ["h2", "s1"]
    },
    {
      "ENDPOINTS": ["h3", "s1"]
    },
    {
      "ENDPOINTS": ["h4", "s1"]
    }
  ]
}