{
  "ID": "TwoSwitchTopology",
  "VERSION": "1.0",
  "DESCRIPTION": "A topology with two switches (s1, s2) connected, and two hosts (h1, h2) connected to separate switches.",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAC": "00:00:00:00:00:01",
        "MAX_CPU": 0.7,
        "MAX_RAM": 512
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24",
        "MAC": "00:00:00:00:00:02"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      },
      {
        "ID": "s2",
        "TYPE": "OVSKernelSwitch"
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "2ms"
      }
    },
    {
      "ENDPOINTS": ["h2", "s2"],
      "PARAMS": {
        "BANDWIDTH": 50,
        "LOSS": 0.5
      }
    },
    {
      "ENDPOINTS": ["s1", "s2"],
      "PARAMS": {
        "BANDWIDTH": 1000,
        "DELAY": "1ms"
      }
    }
  ]
}