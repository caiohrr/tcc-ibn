{
  "ID": "TwelveHostStar",
  "VERSION": "1.0",
  "DESCRIPTION": "A star topology with 12 hosts connected to a single switch, demonstrating different link speeds. Hosts h1-h6 are 'Legacy' with 10Mbps links, and h7-h12 are 'Modern' with 1Gbps links.",
