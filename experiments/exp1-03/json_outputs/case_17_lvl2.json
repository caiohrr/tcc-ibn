{
  "ID": "SimpleLatencyNet",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple network with two hosts and a switch, demonstrating different link latencies.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "DELAY": "20ms"
      }
    },
    {
      "ENDPOINTS": ["h2", "s1"],
      "PARAMS": {
        "DELAY": "10ms"
      }
    }
  ]
}