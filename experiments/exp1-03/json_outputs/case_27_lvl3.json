{
  "ID": "VoIPTestNet",
  "VERSION": "1.0",
  "DESCRIPTION": "Network topology for VoIP testing with specific link parameters and host CPU limits, with monitoring enabled.",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": true
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAX_CPU": 0.9
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24"
      },
      {
        "ID": "h3",
        "IP": "10.0.0.3/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "5ms"
      }
    },
    {
      "ENDPOINTS": ["h2", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "5ms"
      }
    },
    {
      "ENDPOINTS": ["h3", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "5ms"
      }
    }
  ]
}