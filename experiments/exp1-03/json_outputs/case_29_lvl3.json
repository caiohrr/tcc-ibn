{
  "ID": "simple_h1_s1_net",
  "VERSION": "1.0",
  "DESCRIPTION": "A basic network with one host and one switch, with a lossy link.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAX_RAM": 256
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "LOSS": 2
      }
    }
  ]
}