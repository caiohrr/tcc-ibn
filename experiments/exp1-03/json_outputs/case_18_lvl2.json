{
  "ID": "SimpleConnection",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple network connecting h1 to s1 with specified link parameters.",
  "MONITORING": {
    "enabled": false,
    "interval": 10,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch"
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 10,
        "LOSS": 0.5
      }
    }
  ]
}