{
  "ID": "LinearTwoHostsOneSwitch",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple linear topology with two hosts (hA, hB) connected to a single switch (s1).",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "hA",
        "IP": "10.0.0.1/24",
        "MAC": "00:00:00:00:00:0A",
        "MAX_CPU": 0.6,
        "MAX_RAM": 512
      },
      {
        "ID": "hB",
        "IP": "10.0.0.2/24",
        "MAC": "00:00:00:00:00:0B"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["hA", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "10ms"
      }
    },
    {
      "ENDPOINTS": ["hB", "s1"],
      "PARAMS": {
        "BANDWIDTH": 50,
        "LOSS": 0.5
      }
    }
  ]
}