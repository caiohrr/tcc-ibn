{
  "ID": "CentralSwitchNet",
  "VERSION": "1.0",
  "DESCRIPTION": "A central switch topology with four hosts connected to it.",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": true
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAC": "00:00:00:00:00:01",
        "MAX_CPU": 0.7,
        "MAX_RAM": 512
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24",
        "MAC": "00:00:00:00:00:02"
      },
      {
        "ID": "h3",
        "IP": "10.0.0.3/24",
        "MAC": "00:00:00:00:00:03"
      },
      {
        "ID": "h4",
        "IP": "10.0.0.4/24",
        "MAC": "00:00:00:00:00:04"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "10ms"
      }
    },
    {
      "ENDPOINTS": ["h2", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "LOSS": 0.5
      }
    },
    {
      "ENDPOINTS": ["h3", "s1"],
      "PARAMS": {
        "BANDWIDTH": 50
      }
    },
    {
      "ENDPOINTS": ["h4", "s1"]
    }
  ]
}