{
  "ID": "HostSwitchLoss",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple network with one host (h1) connected to one switch (s1), featuring RAM intent for h1 and 2% packet loss on the link.",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24",
        "MAX_RAM": 256
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "LOSS": 2
      }
    }
  ]
}