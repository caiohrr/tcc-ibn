{
  "ID": "StarTopology",
  "VERSION": "1.0",
  "DESCRIPTION": "A star topology connecting 'servidor' and 'cliente' to a 'core' switch.",
  "MONITORING": {
    "enabled": true,
    "interval": 5,
    "recovery_enabled": true
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "servidor",
        "IP": "10.0.0.10/24",
        "MAC": "00:00:00:00:00:0A",
        "MAX_CPU": 0.7,
        "MAX_RAM": 1024
      },
      {
        "ID": "cliente",
        "IP": "10.0.0.20/24",
        "MAC": "00:00:00:00:00:0B"
      }
    ],
    "SWITCHES": [
      {
        "ID": "core",
        "TYPE": "OVSSwitch",
        "PARAMS": {
          "PROTOCOLS": "OpenFlow13"
        }
      }
    ],
    "CONTROLLERS": [
      {
        "ID": "c0",
        "TYPE": "RemoteController",
        "PARAMS": {
          "IP": "127.0.0.1",
          "PORT": 6653
        }
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["servidor", "core"],
      "PARAMS": {
        "BANDWIDTH": 100,
        "DELAY": "2ms",
        "LOSS": 0.1
      }
    },
    {
      "ENDPOINTS": ["cliente", "core"],
      "PARAMS": {
        "BANDWIDTH": 50,
        "DELAY": "5ms"
      }
    }
  ]
}