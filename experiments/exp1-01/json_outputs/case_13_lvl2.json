{
  "ID": "simple_h1_s1_delay",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple topology with h1 connected to s1, featuring a 10ms delay on the link.",
  "MONITORING": {
    "enabled": false,
    "interval": 10,
    "recovery_enabled": false
  },
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch"
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "DELAY": "10ms"
      }
    }
  ]
}