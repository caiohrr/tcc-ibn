{
  "ID": "simple_h1_s1_delay",
  "VERSION": "1.0",
  "DESCRIPTION": "Host h1 connected to switch s1 with a 2ms delay.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "MAC": "00:00:00:00:00:01"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "DELAY": "2ms"
      }
    }
  ]
}