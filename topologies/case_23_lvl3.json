{
  "ID": "memory_limited_host_net",
  "VERSION": "1.0",
  "DESCRIPTION": "A simple network with h1 connected to s1, h1 has a memory limit.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "MAX_RAM": 512
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"]
    }
  ]
}