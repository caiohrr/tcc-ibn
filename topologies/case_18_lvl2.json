{
  "ID": "simple_h1_s1_link",
  "VERSION": "1.0",
  "DESCRIPTION": "Connects h1 to s1 with specified bandwidth and loss.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1",
        "TYPE": "OVSSwitch"
      }
    ]
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 10,
        "LOSS": 0.5
      }
    }
  ]
}