{
  "ID": "simple_h1_h2_net",
  "VERSION": "1.0",
  "DESCRIPTION": "A basic network with two hosts (h1, h2) connected to a single switch, all links with 100Mbps bandwidth.",
  "COMPONENTS": {
    "HOSTS": [
      {
        "ID": "h1",
        "IP": "10.0.0.1/24"
      },
      {
        "ID": "h2",
        "IP": "10.0.0.2/24"
      }
    ],
    "SWITCHES": [
      {
        "ID": "s1"
      }
    ],
    "CONTROLLERS": []
  },
  "CONNECTIONS": [
    {
      "ENDPOINTS": ["h1", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100
      }
    },
    {
      "ENDPOINTS": ["h2", "s1"],
      "PARAMS": {
        "BANDWIDTH": 100
      }
    }
  ]
}